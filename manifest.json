{
  "manifest_version": 3,
  "name": "Playlist Bridge",
  "version": "0.1.0",
  "description": "在 Spotify、YouTube Music、YouTube 之間互轉播放清單（個人使用）",
  "action": {
    "default_title": "Playlist Bridge：轉換播放清單"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": ["storage", "scripting", "tabs", "webRequest"],
  "host_permissions": [
    "https://*.spotify.com/*",
    "https://music.youtube.com/*",
    "https://*.youtube.com/*"
  ]
}
